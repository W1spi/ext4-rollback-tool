# -----------------------------------------------------------------------------
# snapshot-docker.env
#
# Configuration for Docker snapshot script
# -----------------------------------------------------------------------------

# Root directory for all snapshots (recommended to be on a separate disk)
# Example:
#   /var/backups/ext4-rollback
#   /mnt/backups
SNAP_ROOT=/var/backups/ext4-rollback

# Optional override for Docker snapshot location
# Default: ${SNAP_ROOT}/docker
# DEST_BASE=/var/backups/ext4-rollback/docker

# Optional override for log directory
# Default: ${SNAP_ROOT}/_logs
# LOG_DIR=/var/backups/ext4-rollback/_logs

# How many snapshots to keep (rotation)
KEEP_COUNT=28

# Path to Docker projects (compose files, configs, etc.)
# Adjust if your infrastructure lives elsewhere
DOCKER_PROJECTS_DIR=/opt/docker

# Docker daemon configuration directory
DOCKER_ETC_DIR=/etc/docker
