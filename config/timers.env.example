# -----------------------------------------------------------------------------
# Timer configuration for ext4-rollback-tool
#
# These values are used by bin/apply-timers.sh to generate:
#   /etc/systemd/system/snapshot-system.timer
#   /etc/systemd/system/snapshot-docker.timer
#
# OnCalendar format examples:
#   *-*-* 23:30:00        -> every day at 23:30
#   Sun *-*-* 00:30:00    -> every Sunday at 00:30
#   *-*-01 02:00:00       -> every month on day 1 at 02:00
#   Mon,Fri *-*-* 01:00:00 -> every Monday and Friday at 01:00
# -----------------------------------------------------------------------------

# -----------------------------
# SYSTEM SNAPSHOT TIMER
# -----------------------------

SYSTEM_TIMER_DESCRIPTION=Run weekly system snapshot
SYSTEM_ON_CALENDAR=Sun *-*-* 00:30:00
SYSTEM_PERSISTENT=true
SYSTEM_RANDOMIZED_DELAY_SEC=5m

# -----------------------------
# DOCKER SNAPSHOT TIMER
# -----------------------------

DOCKER_TIMER_DESCRIPTION=Run daily Docker snapshot
DOCKER_ON_CALENDAR=*-*-* 23:30:00
DOCKER_PERSISTENT=true
DOCKER_RANDOMIZED_DELAY_SEC=5m
