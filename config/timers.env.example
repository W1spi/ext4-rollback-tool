# -----------------------------------------------------------------------------
# timers.env
#
# Configuration for systemd timers (snapshot scheduling)
#
# Uses systemd OnCalendar syntax:
#   https://www.freedesktop.org/software/systemd/man/systemd.time.html
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# SYSTEM SNAPSHOT TIMER
# -----------------------------------------------------------------------------

# Description for system snapshot timer
SYSTEM_TIMER_DESCRIPTION=System snapshot

# Schedule (examples):
#   daily         → every day at midnight
#   03:00         → every day at 03:00
#   Mon *-*-* 02:00 → every Monday at 02:00
#   *-*-01 03:00 → every 1st day of month at 03:00
SYSTEM_ON_CALENDAR= Mon *-*-* 03:00

# Run missed jobs after reboot
SYSTEM_PERSISTENT=true

# Random delay to spread load (recommended in production)
SYSTEM_RANDOMIZED_DELAY_SEC=5m


# -----------------------------------------------------------------------------
# DOCKER SNAPSHOT TIMER
# -----------------------------------------------------------------------------

# Description for docker snapshot timer
DOCKER_TIMER_DESCRIPTION=Docker snapshot

# Schedule (can be different from system snapshot)
DOCKER_ON_CALENDAR=04:00

# Run missed jobs after reboot
DOCKER_PERSISTENT=true

# Random delay
DOCKER_RANDOMIZED_DELAY_SEC=5m
