# -----------------------------------------------------------------------------
# snapshot-system.env
#
# Configuration for system snapshot script
# -----------------------------------------------------------------------------

# Root directory for all snapshots (recommended to be on a separate disk)
# Example:
#   /var/backups/ext4-rollback
#   /mnt/backups
SNAP_ROOT=/var/backups/ext4-rollback

# Optional override for system snapshot location
# Default: ${SNAP_ROOT}/system
# DEST_BASE=/var/backups/ext4-rollback/system

# Optional override for log directory
# Default: ${SNAP_ROOT}/_logs
# LOG_DIR=/var/backups/ext4-rollback/_logs

# How many snapshots to keep (rotation)
KEEP_COUNT=8

# Source directory for snapshot
#
# WARNING:
#   '/' means full system snapshot (root filesystem)
#
# In most cases you should NOT change this value.
# Only change if you clearly understand what you are doing.
#
# Examples:
#   /        → full system
#   /home    → only user data
SRC=/
