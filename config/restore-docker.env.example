# -----------------------------------------------------------------------------
# restore-docker.env
#
# Configuration for Docker restore script
# -----------------------------------------------------------------------------

# Root directory where snapshots are stored
# Must match SNAP_ROOT used during snapshot creation
SNAP_ROOT=/var/backups/ext4-rollback

# Optional override for Docker snapshot location
# Default: ${SNAP_ROOT}/docker
# SNAP_BASE=/var/backups/ext4-rollback/docker

# Optional override for log directory
# Default: ${SNAP_ROOT}/_logs
# LOG_DIR=/var/backups/ext4-rollback/_logs

# -----------------------------------------------------------------------------
# Restore targets
# -----------------------------------------------------------------------------

# Path where Docker projects will be restored
# This directory will be overwritten by snapshot contents
PROJECTS_DST=/opt/docker

# Docker daemon configuration directory
# This will also be overwritten during restore
ETC_DOCKER_DST=/etc/docker
