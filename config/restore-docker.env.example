# Base directory where docker snapshots are stored
SNAP_BASE=/mnt/nextcloud_data/.infra_snapshots/docker

# Directory for restore logs
LOG_DIR=/mnt/nextcloud_data/.infra_snapshots/_logs

# Restore destination for docker infrastructure
PROJECTS_DST=/opt/devteam/docker

# Restore destination for docker daemon config
ETC_DOCKER_DST=/etc/docker
