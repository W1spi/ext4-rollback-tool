# -----------------------------------------------------------------------------
# restore-system.env
#
# Configuration for system restore script
#
# ⚠️ WARNING:
#   This script restores files directly to '/'
#   and may overwrite critical system data.
# -----------------------------------------------------------------------------

# Root directory where snapshots are stored
# Must match SNAP_ROOT used during snapshot creation
SNAP_ROOT=/var/backups/ext4-rollback

# Optional override for system snapshot location
# Default: ${SNAP_ROOT}/system
# SNAP_BASE=/var/backups/ext4-rollback/system

# Optional override for log directory
# Default: ${SNAP_ROOT}/_logs
# LOG_DIR=/var/backups/ext4-rollback/_logs
